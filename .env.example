# =============================================================================
# AfetRehberi — .env
# Kural: Her bölümde SADECE BİR satır açık kalsın. Diğerlerini # ile kapat.
# Embedding değişince: python main.py ingest  (yeniden indeks gerekir)
# Chat değişince:      servisi yeniden başlatman yeterli
# =============================================================================

# --- Model indirme -----------------------------------------------------------
AFET_ALLOW_MODEL_DOWNLOAD=1
# AFET_ALLOW_MODEL_DOWNLOAD=0          # önbellekte model varsa ağ kullanma

# --- Chat modeli (LLM) — birini seç ------------------------------------------
# Hızlı / hafif (isterlere uygun varsayılan):
AFET_CHAT_MODEL=phi-3.5-mini
# Daha iyi kalite (biraz daha ağır):
# AFET_CHAT_MODEL=phi-4-mini
# Ultra hızlı / düşük RAM (kalite düşer):
# AFET_CHAT_MODEL=qwen2.5-0.5b
# Yüksek kalite (çok RAM, yavaş — güçlü makine):
# AFET_CHAT_MODEL=qwen2.5-7b
# Muhakeme ağırlıklı:
# AFET_CHAT_MODEL=deepseek-r1-7b

# --- Embedding modeli — birini seç -------------------------------------------
# İsterlere uygun varsayılan (değiştirirsen ingest şart):
AFET_EMBEDDING_MODEL=qwen3-embedding-0.6b
# Alternatif alias (katalogda varsa):
# AFET_EMBEDDING_MODEL=qwen3-0.6b-embedding

# --- Retrieval ---------------------------------------------------------------
AFET_TOP_K=3
# AFET_TOP_K=2
# AFET_TOP_K=5
AFET_MIN_SIMILARITY=0.25
# AFET_MIN_SIMILARITY=0.20
# AFET_MIN_SIMILARITY=0.35

# --- Docker / yollar (opsiyonel) ---------------------------------------------
# AFET_DATA_DIR=./data
# AFET_DB_PATH=./knowledge.db
# AFET_MODEL_CACHE_DIR=./models
# AFET_FORCE_INGEST=0
# AFET_FORCE_INGEST=1
